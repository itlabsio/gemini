# Скопируйте в .env.local и заполните. Используется при локальном запуске (set -a; . ./.env.local; set +a).

HEAD_ROLE=source                       # source | target  (target = голова DR-контура)
LISTEN_ADDR=:8080
PUBLIC_URL=http://localhost:8080       # внешний URL этой головы (нужен для межголовых webhook)

POSTGRES_URL=postgres://gemini:gemini@postgres:5432/gemini?sslmode=disable

# Ровно 32 байта — ключ AES-256-GCM для шифрования plain-паролей подключений at rest
SECRET_ENCRYPTION_KEY=change-me-to-a-32-byte-secret-key

OIDC_ISSUER_URL=https://keycloak.example.com/realms/gemini
OIDC_CLIENT_ID=gemini         # тот же клиент, что у фронта (KEYCLOAK_CLIENT_ID)
# superuser — client-роль клиента OIDC_CLIENT_ID; роли по проектам — из claim groups
# (Full group path): /<проект>/<admin|developer|readonly>

# S3 промежуточного хранилища дампов
S3_ENDPOINT=storage.yandexcloud.net
S3_REGION=ru-central1
S3_NAME=
S3_BUCKET=gemini-dumps
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PATH_STYLE=true
S3_USE_SSL=true
S3_DOWNLOADABLE=true

# Vault (опционально; при VAULT_ENABLED=false инстансы могут использовать только auth_type=plain)
VAULT_ENABLED=false
VAULT_ADDR=https://vault.example.com:8200
# kubernetes | token — именно метод. Путь монтирования auth-бэкенда — ниже.
VAULT_AUTH_METHOD=kubernetes
# Путь kubernetes auth-бэкенда в Vault (`vault auth list`), дефолт Vault — kubernetes
VAULT_K8S_MOUNT=kubernetes
VAULT_K8S_ROLE=gemini
# KV-хранилище не настраивается: у инстанса указывается полный путь Vault API
# вместе с mount и (для KV v2) сегментом data/, напр. kv/data/prod/db-backup/core

# Нотификации об ошибках
NOTIFY_ENABLED=false
NOTIFY_PROVIDER=slack
NOTIFY_WEBHOOK_URL=
# telegram: NOTIFY_WEBHOOK_URL=https://api.telegram.org/bot<TOKEN>/sendMessage
NOTIFY_TELEGRAM_CHAT_ID=
NOTIFY_TELEGRAM_THREAD_ID=

# Kubernetes (для локального запуска берётся ~/.kube/config)
K8S_NAMESPACE=gemini
JOB_IMAGE=ghcr.io/itlabsio/gemini/backend:latest
JOB_SERVICE_ACCOUNT=gemini-job
JOB_STORAGE_CLASS=yc-network-ssd
JOB_STORAGE_TYPE=ephemeral             # ephemeral (generic ephemeral PVC) | emptydir — дефолт, переопределяется в UI и на базу
JOB_WORKDIR_SIZE=20Gi
# JOB_POD_OVERRIDES — JSON с nodeSelector/tolerations/affinity/resources dump/restore-подов (обычно ставит Helm)
# JOB_OWNER_DEPLOYMENT — имя Deployment'а backend'а: у него берутся UID (ownerReference
#   для Job/CronJob/Secret), imagePullSecrets и лейбл app.kubernetes.io/instance (ставит Helm)

POLL_INTERVAL=5m
